# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- providers ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Only needed if you point a MODEL_* var at a gemini-* model.
# GEMINI_API_KEY=your-gemini-key-here

# --- per-agent models ---
# Any name 4.x registers in supportedModels. Default: claude-haiku-4-5
MODEL_ANALYST=claude-haiku-4-5
MODEL_BRIEFER=claude-haiku-4-5
MODEL_RESPONDER=claude-haiku-4-5

# --- solana endpoints ---
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- watched programs ---
# Jupiter v6
WATCH_PROGRAM_SOLANA=JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4
# Pump.fun
WATCH_PROGRAM_SOLANA_2=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Minimum net SOL inflow in a sampled tx to raise a large_transfer.
LARGE_TRANSFER_SOL=50

# --- guardrail ---
# auto-reject (default) | auto-approve | prompt
GUARDRAIL_MODE=auto-reject
